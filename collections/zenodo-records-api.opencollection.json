                "description": "Unique record identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a record by ID"
        },
        {
          "info": {
            "name": "Remove a record from a community",
