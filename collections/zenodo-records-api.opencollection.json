          },
          "http": {
            "method": "DELETE",
            "url": "https://zenodo.org/api/records/:recordId/communities",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a record from a community"
