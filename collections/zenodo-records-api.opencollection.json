            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://zenodo.org/api/records/:recordId/access/links/:linkId",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              },
              {
                "name": "linkId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
