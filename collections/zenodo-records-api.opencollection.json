          "http": {
            "method": "PATCH",
            "url": "https://zenodo.org/api/records/:recordId/access/links/:linkId",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              },
              {
                "name": "linkId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
