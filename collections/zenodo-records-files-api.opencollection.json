{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zenodo REST Access Records Files API",
    "version": "12.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Records Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a record's files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/records/:recordId/files",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List a record's files"
        },
        {
          "info": {
            "name": "Get a record file's metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/records/:recordId/files/:file-name",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              },
              {
                "name": "file-name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a record file's metadata"
        },
        {
          "info": {
            "name": "Download a record file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/records/:recordId/files/:file-name/content",
            "params": [
              {
                "name": "recordId",
                "value": "",
                "type": "path"
              },
              {
                "name": "file-name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download a record file"
        }
      ]
    }
  ],
  "bundled": true
}