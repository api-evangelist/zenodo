{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zenodo REST Access Avatars API",
    "version": "12.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Avatars",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user avatar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/users/:userId/avatar.svg",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get user avatar"
        },
        {
          "info": {
            "name": "Get group avatar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/groups/:groupId/avatar.svg",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get group avatar"
        }
      ]
    }
  ],
  "bundled": true
}