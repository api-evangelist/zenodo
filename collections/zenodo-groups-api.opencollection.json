{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zenodo REST Access Groups API",
    "version": "12.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/groups",
            "params": [
              {
                "name": "q",
                "value": "admin",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search groups"
        },
        {
          "info": {
            "name": "Get group by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/groups/:groupId",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get group by ID"
        },
        {
          "info": {
            "name": "Get group avatar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://zenodo.org/api/groups/:groupId/avatar.svg",
            "params": [
              {
                "name": "groupId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get group avatar"
        }
      ]
    }
  ],
  "bundled": true
}